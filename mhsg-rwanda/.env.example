# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgis://mhsg:mhsg@db:5432/mhsg

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── JWT ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Storage ───────────────────────────────────────────────────────────────────
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# ── Payment provider (sandbox) ───────────────────────────────────────────────
PAYMENT_PROVIDER=sandbox
PAYMENT_SANDBOX_SECRET=sandbox-secret
PAYMENT_CALLBACK_SECRET=callback-hmac-secret

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@mhsg.rw

# ── SMS/Notifications ─────────────────────────────────────────────────────────
SMS_PROVIDER=console
SMS_API_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXTAUTH_SECRET=change-me-nextauth
NEXTAUTH_URL=http://localhost:3000

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_HOME_SERVICES=True
PILOT_DISTRICTS=Kigali,Gasabo,Kicukiro,Nyarugenge
